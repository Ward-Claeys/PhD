library(lme4)
options(contrasts = c("contr.treatment", "contr.poly"))
fit <- lmer(rt ~ 1 + fop + fsize + urenwisk +
fop:fsize + fop:urenwisk + fsize:urenwisk +
(1|subject) + (1|subject:fop) + (1|subject:fsize),
data = Data.long)
summary(fit, corr = FALSE)
Anova(fit , test = "Wilks" , type = "II")
Anova(fit , test = "F" , type = "II")
